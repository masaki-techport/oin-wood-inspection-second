# Development Environment Configuration
# Copy this file to .env.development for local development

# === Frontend Configuration ===
REACT_APP_BACKEND_HOST=localhost
REACT_APP_BACKEND_PORT=8000
REACT_APP_API_URL=http://localhost:8000

# Network Settings
REACT_APP_NETWORK_MODE=false
REACT_APP_ENABLE_BACKEND_DISCOVERY=false
REACT_APP_ENABLE_NETWORK_DIAGNOSTICS=true

# Debug Settings
REACT_APP_DEBUG_PROXY=true
REACT_APP_DEBUG_API=true

# === Backend Configuration ===
# Python backend will use these if available
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./wood_inspection.db

# Camera Settings
DEFAULT_CAMERA_TYPE=webcam
CAMERA_BUFFER_SIZE=30
CAMERA_FPS=10