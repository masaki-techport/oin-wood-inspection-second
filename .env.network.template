# Network Environment Configuration
# Copy this file to .env.network for network deployment

# === Frontend Configuration ===
# Use 'auto' to enable automatic IP detection
REACT_APP_BACKEND_HOST=auto
REACT_APP_BACKEND_PORT=8000
# Leave API_URL empty to enable automatic discovery
REACT_APP_API_URL=

# Network Settings - Enable for external device access
REACT_APP_NETWORK_MODE=true
REACT_APP_ENABLE_BACKEND_DISCOVERY=true
REACT_APP_ENABLE_NETWORK_DIAGNOSTICS=true

# Backend Discovery Settings
REACT_APP_FALLBACK_HOSTS=192.168.1.100,192.168.2.100,10.0.0.100
REACT_APP_HEALTH_CHECK_INTERVAL=30000
REACT_APP_DISCOVERY_TIMEOUT=5000

# Debug Settings
REACT_APP_DEBUG_PROXY=true
REACT_APP_DEBUG_API=false

# === Backend Configuration ===
# Python backend configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Auto-detect machine IP for logging and status
DETECT_MACHINE_IP=true
PREFERRED_NETWORK_INTERFACE=

# Database
DATABASE_URL=sqlite:///./wood_inspection.db

# Camera Settings
DEFAULT_CAMERA_TYPE=basler
CAMERA_BUFFER_SIZE=30
CAMERA_FPS=10

# Sensor Settings
SENSOR_CONFIG_FILE=src-api/config/sensor_config.yaml
DIO_DEVICE_IP=auto