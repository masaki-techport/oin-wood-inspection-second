# Production Environment Configuration
# Copy this file to .env.production for production deployment

# === Frontend Configuration ===
# Set specific IP for production or use 'auto' for detection
REACT_APP_BACKEND_HOST=auto
REACT_APP_BACKEND_PORT=8000
REACT_APP_API_URL=

# Network Settings
REACT_APP_NETWORK_MODE=true
REACT_APP_ENABLE_BACKEND_DISCOVERY=true
REACT_APP_ENABLE_NETWORK_DIAGNOSTICS=false

# Production Optimizations
REACT_APP_HEALTH_CHECK_INTERVAL=60000
REACT_APP_DISCOVERY_TIMEOUT=3000
REACT_APP_MAX_RETRY_ATTEMPTS=3

# Debug Settings (disabled in production)
REACT_APP_DEBUG_PROXY=false
REACT_APP_DEBUG_API=false

# === Backend Configuration ===
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=WARNING

# IP Detection
DETECT_MACHINE_IP=true
PREFERRED_NETWORK_INTERFACE=

# Database
DATABASE_URL=sqlite:///./production_wood_inspection.db

# Camera Settings
DEFAULT_CAMERA_TYPE=basler
CAMERA_BUFFER_SIZE=60
CAMERA_FPS=15

# Security Settings
CORS_ORIGINS=
TRUSTED_HOSTS=

# Performance Settings
WORKERS=1
TIMEOUT=30