{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "npm: start",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///./*": "${webRoot}/src/*"
            }
        },
        {
            "name": "Python: src-api/source/main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src-api/source/main.py",
            "cwd": "${workspaceFolder}/src-api"
        }
    ]
}